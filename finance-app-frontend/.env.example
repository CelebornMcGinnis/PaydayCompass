# Copy this to .env.local and fill in with the values CDK prints as
# CfnOutputs after `npm run deploy:beta` (or deploy:prod) in the CDK project.
#
#   SiteUrl            -> not used here directly (that's the deployed
#                          CloudFront URL this app itself gets uploaded to)
#   UserPoolId          -> VITE_COGNITO_USER_POOL_ID
#   UserPoolClientId    -> VITE_COGNITO_CLIENT_ID
#   (the API base is the same CloudFront URL, since CloudFront routes
#    /api/* to API Gateway - see lib/constructs/frontend.ts in the CDK repo)

VITE_API_BASE_URL=https://d111111abcdef8.cloudfront.net/api
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1
